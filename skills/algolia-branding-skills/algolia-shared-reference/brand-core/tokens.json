{
  "$schema": "https://algolia.brand/tokens.schema.json",
  "meta": {
    "name": "Algolia Design System - machine tokens",
    "ssot": "brand-core",
    "truth_source": "https://algolia.frontify.com/document/1",
    "verified": "2026-08-19",
    "rebrand": "2026 Xenon",
    "provenance_legend": {
      "frontify": "read directly on Frontify",
      "derived": "implementation default, NOT published on Frontify"
    }
  },
  "color": {
    "primary": {
      "xenon-blue": { "value": "#0067F7", "provenance": "frontify", "frontify_name": "Blue (Xenon Blue)", "role": "primary brand, logo, CTA, links" },
      "xenon-900":  { "value": "#000033", "provenance": "frontify", "frontify_name": "Dark Blue / Xenon 900", "role": "headlines, dark surfaces, ink" },
      "purple":     { "value": "#8572F6", "provenance": "frontify", "frontify_name": "Purple", "role": "primary (not retired)" },
      "teal":       { "value": "#21C9C4", "provenance": "frontify", "frontify_name": "Teal", "role": "primary" }
    },
    "accent": {
      "lime": { "value": "#CEFF00", "provenance": "frontify", "frontify_name": "Lime / electric-lime" },
      "cyan": { "value": "#5FFBFB", "provenance": "frontify", "frontify_name": "Cyan" }
    },
    "background": {
      "white":      { "value": "#FFFFFF", "provenance": "frontify" },
      "light-gray": { "value": "#F6F6F6", "provenance": "frontify", "frontify_name": "Light Gray" },
      "dark-blue":  { "value": "#000033", "provenance": "frontify", "frontify_name": "Dark Blue" }
    },
    "blue-states": {
      "xenon-blue-700": { "value": "#0052cc", "provenance": "derived", "role": "hover/pressed" },
      "xenon-blue-300": { "value": "#4d95ff", "provenance": "derived" },
      "xenon-blue-100": { "value": "#e0edff", "provenance": "derived", "role": "tint bg" },
      "xenon-blue-050": { "value": "#f0f6ff", "provenance": "derived" }
    },
    "neutral": {
      "provenance": "derived",
      "note": "Frontify names only White, Light Gray #F6F6F6, Xenon 900 #000033; intermediate ramp is implementation default.",
      "gray-000": "#ffffff", "gray-050": "#f6f6f6", "gray-100": "#eceef4", "gray-200": "#dfe2ec",
      "gray-300": "#c4c9d8", "gray-400": "#969db4", "gray-500": "#6b7280", "gray-600": "#474d63",
      "gray-700": "#2b3050", "gray-800": "#14183a", "gray-900": "#000033"
    },
    "state": {
      "provenance": "derived",
      "success": "#059669", "warning": "#d97706", "danger": "#dc2626", "info": "#0067F7"
    },
    "retired_do_not_use": {
      "nebula-blue": "#003DFF",
      "old-ink": ["#021046", "#0e1224"],
      "old-purple": ["#5468FF", "#8A4FFF"],
      "old-teal": "#00C29A",
      "old-cyan": "#00B6FF",
      "fabricated-accents": ["#FF4F81", "#FF7A59", "#FFD64D"],
      "frontify-template-placeholders": ["#00FF11", "#123123", "#BADA55"]
    }
  },
  "typography": {
    "provenance": "frontify",
    "family": "Sora",
    "fallback": "system-ui, -apple-system, 'Segoe UI', sans-serif",
    "weights": [300, 400, 600],
    "styles": ["normal"],
    "forbidden": ["italic", "700+", "Inter", "Roboto", "DM Sans", "Arial", "serif", "system default as brand face"],
    "delivery": "https://fonts.googleapis.com/css2?family=Sora:wght@300;400;600&display=swap",
    "mono": { "value": "JetBrains Mono", "provenance": "derived" },
    "scale": { "provenance": "derived", "note": "Frontify publishes no size scale; see colors_and_type.css" }
  },
  "radius": { "provenance": "derived", "xs": 4, "sm": 6, "md": 8, "lg": 12, "xl": 16, "2xl": 20, "pill": 999 },
  "spacing_grid": { "provenance": "derived", "base": 4 },
  "assets": {
    "logo": { "location": "brand-core/assets/logo/", "formats": ["svg", "png", "eps", "ai"], "provenance": "frontify",
      "vintage_note": "official pack is 2022 in #003DFF; color TOKEN is Xenon; never recolour the file" },
    "photography": { "location": "brand-core/assets/photography/", "count": 8, "provenance": "frontify" },
    "icons": { "location": "brand-core/assets/icons/", "captured": 3, "full_set": "~33 on Frontify (lazy gallery)", "substitute": "Lucide (derived)" },
    "illustrations": {
      "provenance": "frontify",
      "count": 230,
      "distribution": "NOT bundled - fetch on demand from public CDN",
      "catalog": "brand-core/assets/illustrations/illustrations-manifest.json",
      "enriched_catalog": "harvest/frontify/DIGITAL-ASSETS-CATALOG.enriched.json",
      "cdn_pattern": "https://media.ffycdn.net/eu/algolia-brand/{hash}.png?width={width}",
      "selection": "semantic search over vision descriptions + surface(light/dark) filter + confidence floor; inline-as-data-URI only when target is a claude.ai Artifact"
    }
  }
}
